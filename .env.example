# Copy this file to .env. Keep real deployment values out of Git.
# Telemetry is completely disabled if these variables are empty or not configured.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Both GA_MEASUREMENT_ID and VITE_GA_MEASUREMENT_ID are supported.
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (e.g. xxxxxxxxxx)
# Both CLARITY_PROJECT_ID and VITE_CLARITY_PROJECT_ID are supported.
CLARITY_PROJECT_ID=
VITE_CLARITY_PROJECT_ID=
